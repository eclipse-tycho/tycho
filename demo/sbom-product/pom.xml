<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/maven-v4_0_0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>tycho-demo</groupId>
	<artifactId>sbom-product</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>eclipse-repository</packaging>

	<properties>
		<tycho-version>6.0.0-SNAPSHOT</tycho-version>
		<platform-repository>https://download.eclipse.org/releases/2025-09/</platform-repository>
	</properties>

	<repositories>
		<repository>
			<id>platform</id>
			<url>${platform-repository}</url>
			<layout>p2</layout>
		</repository>
	</repositories>

	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho-version}</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho-version}</version>
				<configuration>
					<environments>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
					</environments>
				</configuration>
			</plugin>
			<!-- 1. materialize and archive the product for all environments, this creates target/products/*.zip and *.tar.gz -->
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-p2-director-plugin</artifactId>
				<version>${tycho-version}</version>
				<executions>
					<execution>
						<id>materialize-products</id>
						<goals>
							<goal>materialize-products</goal>
						</goals>
					</execution>
					<execution>
						<id>archive-products</id>
						<goals>
							<goal>archive-products</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
			<!-- 2. analyze all archives, must run after the archives are created (verify > package) -->
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-sbom-plugin</artifactId>
				<version>${tycho-version}</version>
				<executions>
					<execution>
						<id>generate-sbom</id>
						<goals>
							<goal>generator</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<!-- every product archive (*.zip, *.tar.gz) in this folder gets its own SBOM, here one per environment -->
					<installations>${project.build.directory}/products</installations>
					<centralsearch>true</centralsearch>
					<p2sources>
						<p2source>${platform-repository}</p2source>
					</p2sources>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
