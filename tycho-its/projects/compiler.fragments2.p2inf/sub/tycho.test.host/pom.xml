<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>tycho.its</groupId>
	<artifactId>tycho.test.host</artifactId>
	<version>1.0.0</version>
	<packaging>eclipse-plugin</packaging>
	<parent>
		<groupId>tycho.its</groupId>
		<artifactId>tycho.test.bundlewithfragment.p2inf</artifactId>
		<version>1.0.0</version>
		<relativePath>../pom.xml</relativePath>
	</parent>
	<build>
		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<configuration>
					<dependency-resolution>
						<profileProperties>
							<!-- see META-INF/p2.inf: used to disable the requirement on the fragment
								while this bundle is itself being resolved, to avoid a reactor build cycle -->
							<tycho.test.host.buildtime>true</tycho.test.host.buildtime>
						</profileProperties>
					</dependency-resolution>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
