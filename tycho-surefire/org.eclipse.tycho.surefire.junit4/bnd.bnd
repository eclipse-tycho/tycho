# JUnit 4 tests are executed by the JUnit Platform provider of surefire using the JUnit Vintage engine.
# We only import some of the junit packages here to create a requirement on them so that they become
# part of the test runtime, the rest of the content in this bundle is only used to bootstrap surefire
# and does not comply with OSGi rules.
# The vintage engine package is intentionally imported without the 'status' attribute so that this
# works with the Orbit repackaged bundles as well as with the ones from Maven Central (5.12+).
Import-Package: \
 org.junit.platform.launcher;version="[1,2)", \
 org.junit.vintage.engine;version="[5,6)", \
 org.junit;version="[4.12,5)", \
 java.*
Fragment-Host: org.eclipse.tycho.surefire.osgibooter
# The JUnit Runner is still compatible with Java 1.8, as all included upstream dependencies are.
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=1.8))"
-removeheaders: Tool, Bnd-*, Created-By, Private-Package
-fixupmessages "Classes found in the wrong directory"; is:=warning
